<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Hosts the Storage Access Framework pickers (DocumentPicker). -->
        <activity
            android:name="se.bofr.dspi.feature.presets.DocumentPickerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Share sheet for exported configuration / filter files (PresetFiles.share). -->
        <provider
            android:name="se.bofr.dspi.feature.presets.PresetsFileProvider"
            android:authorities="${applicationId}.presets.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/presets_file_paths" />
        </provider>
    </application>
</manifest>
