+    /// Adopt a device handle opened by the embedder instead of by
+    /// enumeration (Android: `UsbDeviceConnection.getFileDescriptor()` ->
+    /// `rusb::GlobalContext::open_device_with_fd`). Claims the vendor
+    /// interface only (never the audio interfaces, no kernel driver detach)
+    /// and connects exactly as `select_device` does.
+    pub fn select_device_handle(&mut self, handle: DeviceHandle<GlobalContext>, serial: &str, vid: u16) -> Result<(), UsbError> {
+        self.disconnect();
+        if let Ok(desc) = handle.device().device_descriptor() {
+            if !is_dspi(desc.vendor_id(), desc.product_id()) {
+                return Err(UsbError::InvalidArgument);
+            }
+        }
+        let _ = handle.claim_interface(crate::protocol::VENDOR_INTERFACE);
+        let connection = UsbConnection::new(handle);
+        self.notify_listener = Some(NotifyListener::start(connection.shared_handle(), Arc::clone(&self.notify_hub)));
+        self.connection = Some(connection);
+        self.connected_vid = Some(vid);
+        self.selected_serial = Some(serial.to_owned());
+        info!("Connected to DSPi device: {serial}");
+        Ok(())
+    }
+
