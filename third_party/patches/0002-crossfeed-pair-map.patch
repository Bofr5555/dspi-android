+/// Extension channel (Bofr5555/DSPi `bofr-main`; 0x00 requested from Weeb
+/// Labs as the reserved extension opcode): wValue is the sub-command, the
+/// direction is the request type (OUT sets, IN gets). Firmware without it
+/// STALLs 0x00, which reads as "no extensions".
+pub const REQ_EXTENSION: u8 = 0x00;
+/// EXT_LIST (IN): the supported sub-command IDs, uint16 LE, ascending.
+pub const EXT_LIST: u16 = 0x0000;
+/// Crossfeed output pair map: 4 bytes, byte p = outputs of pair p (see
+/// [`crossfeed_map_pair`]). OUT ignores an invalid map; IN returns the
+/// normalized live map.
+pub const EXT_CROSSFEED_PAIR_MAP: u16 = 0x0001;
+/// Core voltage (IN: 16-byte CoreVregStatus; OUT: {op, value}); not used by
+/// this core, listed so the IDs stay in one place.
+pub const EXT_CORE_VREG: u16 = 0x0002;
 
 // ADAT input (RP2350)
 pub const REQ_SET_ADAT_INPUT_ENABLE: u8 = 0x68;
@@ -505,6 +519,65 @@ pub const BULK_CHUNK_SIZE: usize = 2048;
 pub const OFF_HEADER: usize = 0;
 pub const OFF_GLOBAL: usize = 16;
 pub const OFF_CROSSFEED: usize = 32;
+/// Crossfeed pair map inside the crossfeed section (the former `reserved2`).
+pub const OFF_CROSSFEED_PAIR_MAP: usize = OFF_CROSSFEED + 12;
+/// Width of the crossfeed pair map (pairs on the widest platform).
+pub const CROSSFEED_MAP_PAIRS: usize = 4;
+
+/// Outputs `(left, right)` of crossfeed pair `p`: map byte 0 = the default
+/// pairing (2p, 2p+1), otherwise `(right << 4) | left` (firmware
+/// `crossfeed_map.h`). The filter is symmetric; left/right only label it.
+pub fn crossfeed_map_pair(map: &[u8; CROSSFEED_MAP_PAIRS], p: usize) -> (u8, u8) {
+    match map[p] {
+        0 => (2 * p as u8, 2 * p as u8 + 1),
+        b => (b & 0x0F, b >> 4),
+    }
+}
+
+/// Map byte for an explicit pair (not normalized; see [`crossfeed_map_normalize`]).
+pub fn crossfeed_map_encode_pair(left: u8, right: u8) -> u8 {
+    ((right & 0x0F) << 4) | (left & 0x0F)
+}
+
+/// Firmware's validity rule: every pair p < `num_pairs` gets two distinct
+/// stereo outputs (< 2 * num_pairs, never the PDM sub), no output is used by
+/// two pairs, and bytes for pairs >= `num_pairs` are 0.
+pub fn crossfeed_map_valid(map: &[u8; CROSSFEED_MAP_PAIRS], num_pairs: usize) -> bool {
+    if num_pairs == 0 || num_pairs > CROSSFEED_MAP_PAIRS {
+        return false;
+    }
+    let mut used = 0u32;
+    for p in 0..CROSSFEED_MAP_PAIRS {
+        if p >= num_pairs {
+            if map[p] != 0 {
+                return false;
+            }
+            continue;
+        }
+        let (l, r) = crossfeed_map_pair(map, p);
+        let n = 2 * num_pairs as u8;
+        if l >= n || r >= n || l == r {
+            return false;
+        }
+        let bits = (1u32 << l) | (1u32 << r);
+        if used & bits != 0 {
+            return false;
+        }
+        used |= bits;
+    }
+    true
+}
+
+/// Explicit default bytes become 0, as the firmware stores and reports them.
+pub fn crossfeed_map_normalize(map: &[u8; CROSSFEED_MAP_PAIRS]) -> [u8; CROSSFEED_MAP_PAIRS] {
+    let mut out = *map;
+    for (p, b) in out.iter_mut().enumerate() {
+        if *b == crossfeed_map_encode_pair(2 * p as u8, 2 * p as u8 + 1) {
+            *b = 0;
+        }
+    }
+    out
+}
