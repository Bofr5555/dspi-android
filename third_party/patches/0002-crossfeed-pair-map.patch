+    /// Which outputs each crossfeed pair processes (K340 firmware fork,
+    /// `REQ_EXTENSION` / `EXT_CROSSFEED_PAIR_MAP`). The whole map is written at once since
+    /// pairs must stay disjoint. A map the firmware would refuse is rejected
+    /// here with `InvalidArgument` (nothing sent, state unchanged); a valid
+    /// one is stored normalized, as the firmware reports it.
+    pub fn set_crossfeed_pair_map(&mut self, map: [u8; CROSSFEED_MAP_PAIRS]) -> Result<()> {
+        if !crossfeed_map_valid(&map, self.state.crossfeed_pair_count()) {
+            return Err(UsbError::InvalidArgument);
+        }
+        let map = crossfeed_map_normalize(&map);
+        self.send(REQ_EXTENSION, EXT_CROSSFEED_PAIR_MAP, WINDEX_GLOBAL, &map)?;
+        self.state.crossfeed_pair_map = map;
+        Ok(())
+    }
+
+    /// Read the live pair map (`REQ_EXTENSION` / `EXT_CROSSFEED_PAIR_MAP`) into the state.
+    /// Firmware without the fork STALLs, so an Err also means "unsupported";
+    /// the state keeps the bulk image's value (zero there = default map).
+    pub fn fetch_crossfeed_pair_map(&mut self) -> Result<[u8; CROSSFEED_MAP_PAIRS]> {
+        let b = self.get_exact(REQ_EXTENSION, EXT_CROSSFEED_PAIR_MAP, WINDEX_GLOBAL, CROSSFEED_MAP_PAIRS as u16, CROSSFEED_MAP_PAIRS)?;
+        let mut map = [0u8; CROSSFEED_MAP_PAIRS];
+        map.copy_from_slice(&b[..CROSSFEED_MAP_PAIRS]);
+        self.state.crossfeed_pair_map = map;
+        Ok(map)
+    }
+
