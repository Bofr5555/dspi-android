+    #[test]
+    fn crossfeed_pair_map_rides_in_the_reserved_word() {
+        let mut img = v32_image();
+        // Firmware without the map writes zero there: the default pairing.
+        let mut s = DspState::default();
+        decode_bulk(&img, &mut s).unwrap();
+        assert_eq!(s.crossfeed_pair_map, [0; 4]);
+        // K340: woofers L=2/R=0, tweeters L=3/R=1.
+        img[OFF_CROSSFEED + 12..OFF_CROSSFEED + 16].copy_from_slice(&[0x02, 0x13, 0, 0]);
+        decode_bulk(&img, &mut s).unwrap();
+        assert_eq!(s.crossfeed_pair_map, [0x02, 0x13, 0, 0]);
+        assert_eq!(crossfeed_map_pair(&s.crossfeed_pair_map, 0), (2, 0));
+        assert_eq!(crossfeed_map_pair(&s.crossfeed_pair_map, 1), (3, 1));
+        assert_eq!(crossfeed_map_pair(&s.crossfeed_pair_map, 2), (4, 5));
+        s.crossfeed_pair_map = [0, 0, 0x54, 0];
+        let e = encode_bulk(&s);
+        assert_eq!(&e[OFF_CROSSFEED_PAIR_MAP..OFF_CROSSFEED_PAIR_MAP + 4], &[0, 0, 0x54, 0]);
+    }
+
+    #[test]
+    fn crossfeed_pair_map_validation_matches_firmware() {
+        let k340 = [0x02, 0x13, 0, 0];
+        assert!(crossfeed_map_valid(&[0; 4], 4) && crossfeed_map_valid(&[0; 4], 2));
+        assert!(crossfeed_map_valid(&k340, 4) && crossfeed_map_valid(&k340, 2));
+        assert!(!crossfeed_map_valid(&[0x11, 0, 0, 0], 4), "same output twice");
+        assert!(!crossfeed_map_valid(&[0x02, 0, 0, 0], 4), "output 2 shared with default pair 1");
+        assert!(!crossfeed_map_valid(&[0x40, 0, 0, 0], 2), "RP2040 output 4 is the PDM sub");
+        assert!(!crossfeed_map_valid(&[0x80, 0, 0, 0], 4), "RP2350 output 8 is the PDM sub");
+        assert!(!crossfeed_map_valid(&[0, 0, 0x54, 0], 2), "pairs beyond the platform must be 0");
+        assert!(crossfeed_map_valid(&[0x76, 0x54, 0x32, 0x10], 4));
+        assert!(!crossfeed_map_valid(&[0; 4], 0) && !crossfeed_map_valid(&[0; 4], 5));
+        assert_eq!(crossfeed_map_normalize(&[0x10, 0x32, 0x54, 0x76]), [0; 4]);
+        assert_eq!(crossfeed_map_normalize(&[0x10, 0x13, 0x02, 0x76]), [0, 0x13, 0x02, 0]);
+        assert_eq!(crossfeed_map_encode_pair(3, 1), 0x13);
+        // Every valid two-pair map (24 pairings, 5 duplicate default encodings).
+        let mut n = 0;
+        for a in 0..=255u8 {
+            for b in 0..=255u8 {
+                if crossfeed_map_valid(&[a, b, 0, 0], 2) {
+                    n += 1;
+                }
+            }
+        }
+        assert_eq!(n, 29);
+    }
