+        assert_eq!(wire_features(16), 0);
+        assert_eq!(wire_features(17), WIRE_FEAT_ADAT_OUT);
+        assert_eq!(wire_features(28) & WIRE_FEAT_SPDIF_IN4, WIRE_FEAT_SPDIF_IN4);
+        assert_eq!(wire_features(28) & WIRE_FEAT_SUBHARM, 0);
+        assert_eq!(wire_features(32), WIRE_FEATURES_ALL);
+        assert_eq!(wire_features(40), WIRE_FEATURES_ALL);
+    }
+
+    #[test]
+    fn image_length_uses_the_header() {
+        let mut h = [0u8; 16];
+        h[0] = 28;
+        write_u16_le(&mut h, 6, 5944);
+        assert_eq!(image_length(&h), 5944);
+        h[0] = 32;
+        write_u16_le(&mut h, 6, 1);
+        assert_eq!(image_length(&h), BULK_PARAMS_SIZE); // V32 never trusts the field
+        h[0] = 33;
+        write_u16_le(&mut h, 6, 6200);
+        assert_eq!(image_length(&h), 6200);
+        write_u16_le(&mut h, 6, 3);
+        assert_eq!(image_length(&h), BULK_PARAMS_SIZE);
+        assert_eq!(image_length(&h[..4]), BULK_PARAMS_SIZE);
+    }
+
+    #[test]
+    fn rejects_what_it_cannot_map() {
+        let mut d = vec![0u8; 6200];
+        d[0] = 15;
+        assert_eq!(normalize(&d), Err(BulkError::UnsupportedVersion(15)));
+        d[0] = 28;
+        assert_eq!(normalize(&d[..5000]).unwrap_err(), BulkError::TooShort);
+        d[0] = 33; // shorter than V32: not append-only any more
+        assert_eq!(normalize(&d[..6000]).unwrap_err(), BulkError::UnsupportedVersion(33));
+        d[5] = 12;
+        d[OFF_LIMITER] = 7; // a limiter "enabled" byte that is not 0/1: misaligned prefix
+        assert_eq!(normalize(&d).unwrap_err(), BulkError::UnsupportedVersion(33));
+        d[OFF_LIMITER] = 1;
+        assert_eq!(normalize(&d).unwrap().1, WIRE_READ_NEWER);
+    }
+
+    #[test]
+    fn v17_tail_moves_by_four_and_input_config_by_one() {
+        let size = bulk_size(17).unwrap();
+        let mut d: Vec<u8> = (0..size).map(|i| (i % 251) as u8 | 1).collect();
+        d[0] = 17;
+        let (img, read) = normalize(&d).unwrap();
+        assert_eq!(read, WIRE_READ_OLDER);
+        assert_eq!(&img[OFF_LEVELLER + 16..OFF_PREAMP], &[0, 0, 0, 0]); // no masks yet
+        assert_eq!(&img[OFF_PREAMP..OFF_INPUT_CONFIG], &d[OFF_PREAMP - 4..OFF_INPUT_CONFIG - 4]);
+        let ic = OFF_INPUT_CONFIG;
+        assert_eq!(&img[ic..ic + 10], &d[ic - 4..ic + 6]);
+        assert_eq!(img[ic + 10], 0);
+        assert_eq!(&img[ic + 11..ic + 16], &d[ic + 6..ic + 11]);
+        assert_eq!(&img[OFF_ADAT..OFF_ADAT + 8], &d[OFF_ADAT - 4..OFF_ADAT + 4]);
+        assert!(img[OFF_ADAT + 8..].iter().all(|&b| b == 0)); // nothing appended yet
+    }
+
+    #[test]
+    fn compat_decode_is_display_only() {
+        let mut s = DspState::default();
+        let mut d = vec![0u8; bulk_size(28).unwrap()];
+        d[0] = 28;
+        d[2] = 17;
+        d[3] = 9;
+        d[4] = 8;
+        write_f32_le(&mut d, OFF_MASTER_VOLUME, -12.0);
+        assert_eq!(decode_bulk_compat(&d, &mut s), Ok(WIRE_READ_OLDER));
+        assert_eq!(s.format_version, 28);
+        assert_eq!(s.master_volume_db, -12.0);
+        assert!(!s.bulk_valid);
+        assert_eq!(s.wire_features, wire_features(28));
+    }
+}
