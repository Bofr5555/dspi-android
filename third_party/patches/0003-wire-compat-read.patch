--- a/core/src/wirecompat.rs	1970-01-01 01:00:00.000000000 +0100
+++ b/core/src/wirecompat.rs	2026-11-05 22:40:57.311844550 +0100
@@ -0,0 +1,329 @@
+//! Best-effort reading of bulk images in other wire format versions.
+//!
+//! The core models wire format V32 (`WIRE_FORMAT_VERSION`). Since the V16
+//! break the firmware changed the bulk layout only in these ways (firmware
+//! `bulk_params.h` version log, checked against the struct of every shipped
+//! release):
+//!
+//! - sections appended at the end: V17 ADAT output, V23 psybass, V25 upmixer,
+//!   V29 subharmonic synth (16 bytes; V30 grew it, then still the last
+//!   section, to 36), V31 tube, V32 limiter;
+//! - reserved bytes claimed in place, size unchanged: V19 loudness mask, V20
+//!   crossfeed pair mask, V21 I2S clock mode / S/PDIF 2-3 / clock-pin mode,
+//!   V22 Linkwitz Transform Q, V24 ADAT input, V26 upmixer presence;
+//! - two in-place growths that MOVE later bytes: V18 grew the leveller from
+//!   16 to 20 bytes (every later section moves by 4), V28 grew the input
+//!   config's S/PDIF pin array from 2 to 3 (the fields after it move by 1
+//!   inside the section, whose size is unchanged).
+//!
+//! [`normalize`] maps an image of V16..V31 onto the V32 layout (fields the
+//! firmware did not have yet stay zero, which is also the firmware's own
+//! "absent" encoding for the claimed bytes), and keeps the V32 prefix of a
+//! newer image after a plausibility check. The result is for DISPLAY only:
+//! [`decode_bulk_compat`] leaves `bulk_valid` false for anything but an exact
+//! V32 image, so `apply_all_params` never sends a re-encoded image to a
+//! firmware of another version (it would refuse it anyway, or worse, a newer
+//! one could accept a V32 image and zero the sections appended after V32).
+
+use crate::protocol::*;
+use crate::state::DspState;
+use crate::types::{CHANNEL_NAME_LEN, MAX_CHANNELS, MAX_INPUTS, MAX_OUTPUTS};
+
+/// No bulk image decoded.
+pub const WIRE_READ_NONE: u8 = 0;
+/// The image is this core's own wire format.
+pub const WIRE_READ_EXACT: u8 = 1;
+/// An older image (V16..V31) mapped onto the V32 layout, for display only.
+pub const WIRE_READ_OLDER: u8 = 2;
+/// The V32 prefix of a newer image (appended sections ignored), for display only.
+pub const WIRE_READ_NEWER: u8 = 3;
+
+/// ADAT output section (V17).
+pub const WIRE_FEAT_ADAT_OUT: u32 = 1 << 0;
+/// Leveller detector/apply masks (V18).
+pub const WIRE_FEAT_LEVELLER_MASKS: u32 = 1 << 1;
+/// Per-output loudness mask (V19).
+pub const WIRE_FEAT_LOUDNESS_MASK: u32 = 1 << 2;
+/// Crossfeed output-pair mask (V20).
+pub const WIRE_FEAT_CROSSFEED_MASK: u32 = 1 << 3;
+/// I2S clock master/slave, S/PDIF inputs 2-3, I2S clock-pin mode (V21).
+pub const WIRE_FEAT_I2S_CLOCK_MODE: u32 = 1 << 4;
+/// Linkwitz Transform target Q in the band bytes (V22).
+pub const WIRE_FEAT_LINKWITZ: u32 = 1 << 5;
+/// Psychoacoustic bass (V23).
+pub const WIRE_FEAT_PSYBASS: u32 = 1 << 6;
+/// ADAT input (V24).
+pub const WIRE_FEAT_ADAT_IN: u32 = 1 << 7;
+/// Stereo upmixer (V25; the official clients need V26, see UPMIX_PRESENCE).
+pub const WIRE_FEAT_UPMIX: u32 = 1 << 8;
+/// Upmixer presence bell (V26).
+pub const WIRE_FEAT_UPMIX_PRESENCE: u32 = 1 << 9;
+/// Fourth S/PDIF input; first-order low/high pass filter types (V28).
+pub const WIRE_FEAT_SPDIF_IN4: u32 = 1 << 10;
+/// Subharmonic synthesizer (V29).
+pub const WIRE_FEAT_SUBHARM: u32 = 1 << 11;
+/// Subharmonic third band, selectivity, ceiling, pair link (V30).
+pub const WIRE_FEAT_SUBHARM_EXT: u32 = 1 << 12;
+/// Tube modeller (V31).
+pub const WIRE_FEAT_TUBE: u32 = 1 << 13;
+/// Output limiter (V32).
+pub const WIRE_FEAT_LIMITER: u32 = 1 << 14;
+/// Every feature the V32 layout carries.
+pub const WIRE_FEATURES_ALL: u32 = (1 << 15) - 1;
+
+/// (feature, first wire format that carries it)
+const FEATURE_SINCE: [(u32, u8); 15] = [
+    (WIRE_FEAT_ADAT_OUT, 17),
+    (WIRE_FEAT_LEVELLER_MASKS, 18),
+    (WIRE_FEAT_LOUDNESS_MASK, 19),
+    (WIRE_FEAT_CROSSFEED_MASK, 20),
+    (WIRE_FEAT_I2S_CLOCK_MODE, 21),
+    (WIRE_FEAT_LINKWITZ, 22),
+    (WIRE_FEAT_PSYBASS, 23),
+    (WIRE_FEAT_ADAT_IN, 24),
+    (WIRE_FEAT_UPMIX, 25),
+    (WIRE_FEAT_UPMIX_PRESENCE, 26),
+    (WIRE_FEAT_SPDIF_IN4, 28),
+    (WIRE_FEAT_SUBHARM, 29),
+    (WIRE_FEAT_SUBHARM_EXT, 30),
+    (WIRE_FEAT_TUBE, 31),
+    (WIRE_FEAT_LIMITER, 32),
+];
+
+/// `WIRE_FEAT_*` bits a firmware of wire format `version` carries in its bulk
+/// image (0 below V16; every known bit for V32 and newer).
+pub fn wire_features(version: u8) -> u32 {
+    if version < MIN_WIRE_FORMAT_VERSION {
+        return 0;
+    }
+    FEATURE_SINCE.iter().filter(|(_, v)| version >= *v).fold(0, |m, (f, _)| m | f)
+}
+
+/// sizeof(WireBulkParams) of wire format `version` (V16..V32).
+pub fn bulk_size(version: u8) -> Option<usize> {
+    Some(match version {
+        16 => 5864,
+        17 => 5872,
+        18..=22 => 5876,
+        23 | 24 => 5900,
+        25..=28 => 5944,
+        29 => 5960,
+        30 => 5980,
+        31 => 6028,
+        32 => BULK_PARAMS_SIZE,
+        _ => return None,
+    })
+}
+
+/// How many bytes to read for the image whose first bytes are `head`: the
+/// header's payload_length (older firmware STALLs a chunk read past its end,
+/// newer firmware appends), the V32 size for a V32 image or an implausible
+/// length.
+pub fn image_length(head: &[u8]) -> usize {
+    if head.len() < OFF_HEADER + 8 || head[OFF_HEADER] == WIRE_FORMAT_VERSION {
+        return BULK_PARAMS_SIZE;
+    }
+    let len = read_u16_le(head, OFF_HEADER + 6) as usize;
+    if len < OFF_GLOBAL {
+        BULK_PARAMS_SIZE
+    } else {
+        len
+    }
+}
+
+/// Map `data` onto the V32 layout. Returns the V32-sized image (its header
+/// still carries the device's version and length) and `WIRE_READ_*`.
+pub fn normalize(data: &[u8]) -> Result<(Vec<u8>, u8), BulkError> {
+    if data.len() < OFF_GLOBAL {
+        return Err(BulkError::TooShort);
+    }
+    let v = data[OFF_HEADER];
+    if v < MIN_WIRE_FORMAT_VERSION {
+        return Err(BulkError::UnsupportedVersion(v));
+    }
+    if v >= WIRE_FORMAT_VERSION {
+        if data.len() < BULK_PARAMS_SIZE {
+            return Err(if v == WIRE_FORMAT_VERSION {
+                BulkError::TooShort
+            } else {
+                // A newer image shorter than V32 broke the append-only rule.
+                BulkError::UnsupportedVersion(v)
+            });
+        }
+        let img = data[..BULK_PARAMS_SIZE].to_vec();
+        if v == WIRE_FORMAT_VERSION {
+            return Ok((img, WIRE_READ_EXACT));
+        }
+        if !plausible_prefix(&img) {
+            return Err(BulkError::UnsupportedVersion(v));
+        }
+        return Ok((img, WIRE_READ_NEWER));
+    }
+
+    let size = bulk_size(v).ok_or(BulkError::UnsupportedVersion(v))?;
+    if data.len() < size {
+        return Err(BulkError::TooShort);
+    }
+    let mut out = vec![0u8; BULK_PARAMS_SIZE];
+    // Header through the first 16 leveller bytes: same offsets in every version.
+    out[..OFF_LEVELLER + 16].copy_from_slice(&data[..OFF_LEVELLER + 16]);
+    // V18 grew the leveller by 4 (detector/apply masks); older images have
+    // every later section 4 bytes earlier.
+    let shift = if v < 18 { 4 } else { 0 };
+    if v >= 18 {
+        out[OFF_LEVELLER + 16..OFF_PREAMP].copy_from_slice(&data[OFF_LEVELLER + 16..OFF_PREAMP]);
+    }
+    // Preamp .. crossovers, plus the ADAT output section from V17.
+    let end = if v >= 17 { OFF_ADAT + 8 } else { OFF_ADAT };
+    out[OFF_PREAMP..end].copy_from_slice(&data[OFF_PREAMP - shift..end - shift]);
+    // V28 grew spdif_rx_pin_ext from 2 to 3 entries: before it, the enable
+    // mask, I2S clock mode and the three ADAT input bytes sat one byte earlier.
+    if v < 28 {
+        let ic = OFF_INPUT_CONFIG;
+        let tail: [u8; 5] = out[ic + 10..ic + 15].try_into().unwrap();
+        out[ic + 10] = 0; // S/PDIF 4 pin: absent
+        out[ic + 11..ic + 16].copy_from_slice(&tail);
+    }
+    // Appended sections (all after V18, so unshifted).
+    let mut tail = |since: u8, off: usize, len: usize| {
+        if v >= since {
+            out[off..off + len].copy_from_slice(&data[off..off + len]);
+        }
+    };
+    tail(23, OFF_PSYBASS, OFF_UPMIX - OFF_PSYBASS);
+    tail(25, OFF_UPMIX, OFF_SUBHARM - OFF_UPMIX);
+    tail(29, OFF_SUBHARM, if v == 29 { 16 } else { OFF_TUBE - OFF_SUBHARM });
+    tail(31, OFF_TUBE, OFF_LIMITER - OFF_TUBE);
+    Ok((out, WIRE_READ_OLDER))
+}
+
+/// Checks that a newer image's V32 prefix still lines up: the header counts,
+/// the channel names (NUL-terminated, middle of the image) and the limiter
+/// records (its end). A newer firmware that grew a section in place, as V18
+/// and V28 did, fails here instead of being shown garbled.
+fn plausible_prefix(d: &[u8]) -> bool {
+    let h = |k: usize| d[OFF_HEADER + k];
+    if h(2) as usize > MAX_CHANNELS || h(3) as usize > MAX_OUTPUTS || h(4) as usize > MAX_INPUTS || h(5) != 12 {
+        return false;
+    }
+    let names_ok = (0..MAX_CHANNELS).all(|ch| {
+        let off = OFF_CHANNEL_NAMES + ch * CHANNEL_NAME_LEN;
+        d[off..off + CHANNEL_NAME_LEN].contains(&0)
+    });
+    let limiter_ok = (0..MAX_OUTPUTS).all(|o| {
+        let off = OFF_LIMITER + o * 12;
+        d[off] <= 1 && d[off + 1] <= 4 && d[off + 2] == 0 && d[off + 3] == 0
+    });
+    names_ok && limiter_ok
+}
+
+/// Decode a bulk image of any supported wire format into `state`. Returns
+/// `WIRE_READ_*`. For anything but `WIRE_READ_EXACT` the state is for display
+/// only: `bulk_valid` stays false (no bulk write-back) and `wire_features`
+/// says which features the firmware has.
+pub fn decode_bulk_compat(data: &[u8], state: &mut DspState) -> Result<u8, BulkError> {
+    let (img, read) = normalize(data)?;
+    decode_image(&img, state);
+    state.wire_read = read;
+    state.wire_features = if read == WIRE_READ_OLDER { wire_features(data[OFF_HEADER]) } else { WIRE_FEATURES_ALL };
+    if read != WIRE_READ_EXACT {
+        state.bulk_valid = false;
+    }
+    Ok(read)
+}
+
