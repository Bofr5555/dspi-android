+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::protocol::*;
+    use crate::state::COMPAT_OK;
+    use crate::DspiCore;
+
+    /// A transport without chunked bulk (as DSPi Link): records every request.
+    struct Mock {
+        image: Mutex<Vec<u8>>,
+        log: Mutex<Vec<(u8, u8, u16)>>,
+        chunked: bool,
+    }
+
+    impl Mock {
+        fn new(chunked: bool) -> Arc<Self> {
+            let mut d = vec![0u8; BULK_PARAMS_SIZE];
+            d[0] = WIRE_FORMAT_VERSION;
+            d[1] = 1;
+            d[2] = 17;
+            d[3] = 9;
+            d[4] = 8;
+            d[5] = 12;
+            Arc::new(Self { image: Mutex::new(d), log: Mutex::new(Vec::new()), chunked })
+        }
+        fn requests(&self) -> Vec<u8> {
+            self.log.lock().unwrap().iter().map(|r| r.1).collect()
+        }
+    }
+
+    impl Transport for Mock {
+        fn write_control(&self, request: u8, value: u16, _index: u16, data: &[u8], _t: Duration) -> rusb::Result<usize> {
+            self.log.lock().unwrap().push((0, request, value));
+            if request == REQ_SET_ALL_PARAMS {
+                *self.image.lock().unwrap() = data.to_vec();
+            }
+            Ok(data.len())
+        }
+        fn read_control(&self, request: u8, value: u16, _index: u16, buf: &mut [u8], _t: Duration) -> rusb::Result<usize> {
+            self.log.lock().unwrap().push((1, request, value));
+            let src: Vec<u8> = match request {
+                REQ_GET_PLATFORM => vec![1, 1, 0x16, 9, 1, 6, 5],
+                REQ_GET_ALL_PARAMS => self.image.lock().unwrap().clone(),
+                REQ_GET_ALL_PARAMS_CHUNK => {
+                    let img = self.image.lock().unwrap();
+                    img[value as usize..(value as usize + buf.len()).min(img.len())].to_vec()
+                }
+                _ => return Err(rusb::Error::Pipe),
+            };
+            let n = src.len().min(buf.len());
+            buf[..n].copy_from_slice(&src[..n]);
+            Ok(n)
+        }
+        fn read_notification(&self, _buf: &mut [u8], timeout: Duration) -> rusb::Result<Notification> {
+            std::thread::sleep(timeout.min(Duration::from_millis(20)));
+            Err(rusb::Error::Timeout)
+        }
+        fn caps(&self) -> TransportCaps {
+            if self.chunked { TransportCaps::USB } else { TransportCaps { chunked_bulk: false, max_payload: 8192 } }
+        }
+    }
+
+    fn connected(t: Arc<Mock>) -> DspiCore {
+        let mut c = DspiCore::new();
+        c.device_manager.select_transport(t, "0123456789ABCDEF", VENDOR_ID);
+        c
+    }
+
+    #[test]
+    fn single_shot_bulk_when_the_transport_forbids_chunks() {
+        let t = Mock::new(false);
+        let mut c = connected(Arc::clone(&t));
+        c.fetch_all().unwrap();
+        assert_eq!(c.state.compat, COMPAT_OK);
+        let reqs = t.requests();
+        assert!(reqs.contains(&REQ_GET_ALL_PARAMS));
+        assert!(!reqs.contains(&REQ_GET_ALL_PARAMS_CHUNK));
+        c.state.master_volume_db = -20.0;
+        c.apply_all_params().unwrap();
+        let reqs = t.requests();
+        assert_eq!(reqs.iter().filter(|&&r| r == REQ_SET_ALL_PARAMS).count(), 1);
+        assert!(!reqs.contains(&REQ_SET_ALL_PARAMS_CHUNK));
+        assert_eq!(t.image.lock().unwrap().len(), BULK_PARAMS_SIZE);
+    }
+
+    #[test]
+    fn chunked_bulk_over_usb_as_before() {
+        let t = Mock::new(true);
+        let mut c = connected(Arc::clone(&t));
+        c.fetch_all().unwrap();
+        let reqs = t.requests();
+        assert!(reqs.contains(&REQ_GET_ALL_PARAMS_CHUNK));
+        assert!(!reqs.contains(&REQ_GET_ALL_PARAMS));
+    }
