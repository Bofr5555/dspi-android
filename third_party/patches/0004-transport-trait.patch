+/// One packet read from a transport's notification channel.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Notification {
+    /// Bytes written into the caller's buffer (0 = nothing, e.g. a keep-alive).
+    pub len: usize,
+    /// DSPi Link: the session the hub attributes the change to (0 = unknown).
+    /// `None` on a transport that cannot attribute (USB), where every
+    /// `HOST_SET` packet is this host's own write.
+    pub origin: Option<u16>,
+}
+
+/// How bulk parameters travel and what the far side accepts.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct TransportCaps {
+    /// The chunked bulk requests (0xA2/0xA3) are allowed. False on DSPi
+    /// Link, whose clients send the single-shot 0xA0/0xA1 only (Link spec
+    /// section 8.2; a bridge hub refuses the chunked forms).
+    pub chunked_bulk: bool,
+    /// Largest payload of one transfer, either direction (Link
+    /// `limits.max_payload`). `usize::MAX` = no limit beyond the request's.
+    pub max_payload: usize,
+}
+
+impl TransportCaps {
+    /// Direct USB: chunked bulk, no payload limit of its own.
+    pub const USB: Self = Self { chunked_bulk: true, max_payload: usize::MAX };
+}
+
+/// A link to one DSPi: vendor control transfers plus the notification
+/// channel. Implemented for USB here ([`UsbTransport`]) and by embedders for
+/// other links (DSPi Link over the network, MIDI, UART).
+///
+/// Errors use `rusb::Error` so the core's existing handling applies to every
+/// transport; a non-USB transport maps its failures onto it: a refused
+/// request (USB STALL, Link `ERROR`) is `Pipe`, which is what the analyser's
+/// per-channel fallback and the capability probes look for; a timeout is
+/// `Timeout` (the request may or may not have run: never blindly retry a
+/// SET); a lost link is `NoDevice`.
+pub trait Transport: Send + Sync {
+    /// Host-to-device vendor request (bmRequestType 0x41). `timeout` is the
+    /// caller's USB budget; a slower link applies its own.
+    fn write_control(&self, request: u8, value: u16, index: u16, data: &[u8], timeout: Duration) -> rusb::Result<usize>;
+
+    /// Device-to-host vendor request (bmRequestType 0xC1) into `buf`; returns
+    /// the bytes received (a short read is not an error).
+    fn read_control(&self, request: u8, value: u16, index: u16, buf: &mut [u8], timeout: Duration) -> rusb::Result<usize>;
+
+    /// Wait up to `timeout` for the next notification packet, copied
+    /// verbatim into `buf`. `Err(Timeout)` when none arrived.
+    fn read_notification(&self, buf: &mut [u8], timeout: Duration) -> rusb::Result<Notification>;
+
+    /// Recover the notification channel after `read_notification` reported
+    /// `Pipe` (USB: clear the endpoint halt).
+    fn clear_notification_halt(&self) {}
+
+    /// This host's own session id on a shared link (DSPi Link `session`),
+    /// compared with [`Notification::origin`] to recognise its own echoes.
+    fn session_id(&self) -> Option<u16> {
+        None
+    }
+
+    fn caps(&self) -> TransportCaps {
+        TransportCaps::USB
+    }
+
+    /// Take the far side's exclusive device lock for a long operation (Link
+    /// spec section 7.7). True when held or when the transport has no locks;
+    /// false when another client holds it (the caller then sends nothing).
+    fn lock(&self, _reason: &str, _timeout: Duration) -> bool {
+        true
+    }
+
+    /// Release [`Transport::lock`]. Never blocks.
+    fn unlock(&self) {}
+}
+
+/// [`Transport`] over a libusb device handle (the upstream behaviour).
+pub struct UsbTransport {
+    handle: DeviceHandle<GlobalContext>,
+}
+
+impl UsbTransport {
+    pub fn new(handle: DeviceHandle<GlobalContext>) -> Self {
+        Self { handle }
+    }
+}
+
+impl Transport for UsbTransport {
+    fn write_control(&self, request: u8, value: u16, index: u16, data: &[u8], timeout: Duration) -> rusb::Result<usize> {
+        self.handle.write_control(REQ_TYPE_OUT, request, value, index, data, timeout)
+    }
+
+    fn read_control(&self, request: u8, value: u16, index: u16, buf: &mut [u8], timeout: Duration) -> rusb::Result<usize> {
+        self.handle.read_control(REQ_TYPE_IN, request, value, index, buf, timeout)
+    }
+
+    fn read_notification(&self, buf: &mut [u8], timeout: Duration) -> rusb::Result<Notification> {
+        let len = self.handle.read_bulk(NOTIFY_ENDPOINT, buf, timeout)?;
+        Ok(Notification { len, origin: None })
+    }
+
+    fn clear_notification_halt(&self) {
+        let _ = self.handle.clear_halt(NOTIFY_ENDPOINT);
+    }
+}
