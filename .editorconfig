root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 140
ktlint_function_naming_ignore_when_annotated_with = Composable
# Wildcard imports are allowed for the domain package only via generated files (excluded anyway).
ktlint_standard_no-wildcard-imports = enabled

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.sh]
indent_size = 2
